# --- Database ---
POSTGRES_DB=seaside
POSTGRES_USER=seaside
POSTGRES_PASSWORD=seaside
DATABASE_URL=postgresql://seaside:seaside@postgres:5432/seaside

# --- Django ---
DJANGO_SETTINGS_MODULE=seaside.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
ALLOWED_HOSTS=*

# --- Redis/Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Storage (MinIO/S3) ---
S3_BUCKET_NAME=seaside-media
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_USE_SSL=0

# --- Email (SES in prod, MailHog in dev) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=Seaside Tech Co <no-reply@seaside.local>

# --- AWS (SES/SNS in prod) ---
AWS_REGION_NAME=us-east-1

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me

# --- Security ---
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000


